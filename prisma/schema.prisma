// ============================================================
// LibreChat-style AI Workspace — Prisma schema (SQLite)
// ============================================================
//
// Persists: assistants, knowledge docs, projects + documents,
// conversations + messages.
//
// Note: SQLite has no native list/array type, so JSON-encoded
// strings are used for tool whitelists, tags, etc. (per project rule).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === Assistants (Onyx-style) ===
model Assistant {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  systemPrompt String   @default("")
  model        String   @default("default")
  tools        String   @default("[]") // JSON array of tool names
  knowledgeIds String   @default("[]") // JSON array of KnowledgeDoc ids
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// === Knowledge base (Onyx-style RAG-lite) ===
model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  source    String
  content   String
  tags      String   @default("[]") // JSON array of strings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

// === Projects + Documents ===
model Project {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  instructions String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents Document[]
}

model Document {
  id        String   @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("text") // code | text | instruction | config
  content   String   @default("")
  language  String?
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// === Conversations + Messages (server-side chat persistence) ===
model Conversation {
  id          String   @id @default(cuid())
  title       String   @default("New Chat")
  model       String   @default("default")
  assistantId String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]

  @@index([updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String   @default("")
  toolExecutions String   @default("[]") // JSON array
  attachments    String   @default("[]") // JSON: user-uploaded files/images [{kind,id,name,mime,size,url?}]
  images         String   @default("[]") // JSON: AI-generated images [{id,url,prompt,size,width,height}]
  webSearch      String?               // JSON: {query, results:[{url,name,snippet,host_name,date,favicon}]}
  audioPath      String?               // server path for TTS read-aloud cache
  sessionId      String? // server-side /api/chat session id (for tool history)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

// === Generated images (history + dedup) ===
model GeneratedImage {
  id             String   @id @default(cuid())
  conversationId String?
  messageId      String?
  prompt         String
  size           String   @default("1024x1024")
  path           String   // absolute file path on disk
  width          Int     @default(1024)
  height         Int     @default(1024)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

// === Assets (uploaded files, audio cache, etc.) ===
model Asset {
  id        String   @id @default(cuid())
  kind      String   // 'image' | 'file' | 'audio'
  path      String   // absolute file path on disk
  mime      String
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

// === Shared conversations (public read-only links) ===
model SharedConversation {
  id             String   @id @default(cuid())
  shareId        String   @unique // short public id in the URL
  conversationId String
  title          String
  messages       String   @default("[]") // JSON snapshot of messages at share time
  createdAt      DateTime @default(now())

  @@index([shareId])
}

// === Approval Requests (real approval workflow for dangerous tools) ===
// Status machine: PENDING_APPROVAL -> APPROVED -> EXECUTING -> COMPLETED
//                                              -> REJECTED
//                                            -> EXPIRED (auto, by background sweep)
//                                            -> FAILED (execution error)
// Token is single-use and hashed (SHA-256). Draft is immutable; an edit creates
// a new ApprovalRequest with parentApprovalId pointing back, and the original is
// marked SUPERSEDED (a terminal state that also invalidates the old token).
model ApprovalRequest {
  id              String   @id @default(cuid())
  // The tool call this approval is for (e.g. "send_email_with_approval").
  toolName        String
  toolUseId       String?  // toolu_... id from the chat stream (if applicable)
  // Immutable draft args (JSON). For email: {to, subject, body}.
  argsJson        String
  // Conversation context for the UI to surface the request inline.
  conversationId  String?
  // Single-use approval token (plaintext issued to UI; the hashed form is stored).
  tokenHash       String   @unique
  // Status enum: PENDING_APPROVAL | APPROVED | REJECTED | EXPIRED | EXECUTING | COMPLETED | FAILED | SUPERSEDED
  status          String   @default("PENDING_APPROVAL")
  // Token expiry (default 15 min from creation). Sweep marks EXPIRED.
  expiresAt       DateTime
  // Edit chain: if the user edits the draft, a new ApprovalRequest is created with
  // parentApprovalId = this one, and this one is set to SUPERSEDED.
  parentApprovalId String?
  // Who/what decided. In this single-user sandbox it's "user"; production would
  // record an authenticated user id + session.
  decidedBy       String?
  decidedAt       DateTime?
  executedAt      DateTime?
  // JSON of the final result (success data or error message).
  resultJson      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([conversationId])
  @@index([status])
  @@index([expiresAt])
}

// === Tool Call Audit Log (observability — every tool call logged) ===
// One row per tool invocation, success or failure. Powers /api/audit and
// gives us: tool name, args, duration, status, retries, truncation, errors,
// approval linkage — everything needed to debug and control cost.
model ToolCallAudit {
  id              String   @id @default(cuid())
  conversationId  String?
  // The chat-stream turn that issued this call (sessionId in code).
  sessionId       String?
  toolName        String
  // Args the model sent (JSON). Truncated to 8 KB to bound row size.
  argsJson        String
  // Result summary: success | failure | denied | invalid | pending
  status          String
  durationMs      Int      @default(0)
  retries         Int      @default(0)
  // Error message (if status != success). Null on success.
  errorMessage    String?
  // Whether the result was truncated before being handed back to the model.
  resultTruncated Boolean  @default(false)
  // Original result size in bytes (before truncation) for cost/debugging.
  resultBytes     Int      @default(0)
  // If this call needed approval, link to the ApprovalRequest.
  approvalId      String?
  // For schema validation failures: the Zod error flatten() output (JSON).
  validationError String?
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([toolName])
  @@index([status])
  @@index([createdAt])
}
