// ============================================================
// LibreChat-style AI Workspace — Prisma schema (SQLite)
// ============================================================
//
// Persists: assistants, knowledge docs, projects + documents,
// conversations + messages.
//
// Note: SQLite has no native list/array type, so JSON-encoded
// strings are used for tool whitelists, tags, etc. (per project rule).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === Assistants (Onyx-style) ===
model Assistant {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  systemPrompt String   @default("")
  model        String   @default("default")
  tools        String   @default("[]") // JSON array of tool names
  knowledgeIds String   @default("[]") // JSON array of KnowledgeDoc ids
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// === Knowledge base (Onyx-style RAG-lite) ===
model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  source    String
  content   String
  tags      String   @default("[]") // JSON array of strings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

// === Projects + Documents ===
model Project {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  instructions String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents Document[]
}

model Document {
  id        String   @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("text") // code | text | instruction | config
  content   String   @default("")
  language  String?
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// === Conversations + Messages (server-side chat persistence) ===
model Conversation {
  id          String   @id @default(cuid())
  title       String   @default("New Chat")
  model       String   @default("default")
  assistantId String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]

  @@index([updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String   @default("")
  toolExecutions String   @default("[]") // JSON array
  attachments    String   @default("[]") // JSON: user-uploaded files/images [{kind,id,name,mime,size,url?}]
  images         String   @default("[]") // JSON: AI-generated images [{id,url,prompt,size,width,height}]
  webSearch      String?               // JSON: {query, results:[{url,name,snippet,host_name,date,favicon}]}
  audioPath      String?               // server path for TTS read-aloud cache
  sessionId      String? // server-side /api/chat session id (for tool history)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

// === Generated images (history + dedup) ===
model GeneratedImage {
  id             String   @id @default(cuid())
  conversationId String?
  messageId      String?
  prompt         String
  size           String   @default("1024x1024")
  path           String   // absolute file path on disk
  width          Int     @default(1024)
  height         Int     @default(1024)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

// === Assets (uploaded files, audio cache, etc.) ===
model Asset {
  id        String   @id @default(cuid())
  kind      String   // 'image' | 'file' | 'audio'
  path      String   // absolute file path on disk
  mime      String
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

// === Shared conversations (public read-only links) ===
model SharedConversation {
  id             String   @id @default(cuid())
  shareId        String   @unique // short public id in the URL
  conversationId String
  title          String
  messages       String   @default("[]") // JSON snapshot of messages at share time
  createdAt      DateTime @default(now())

  @@index([shareId])
}

// === Approval Requests (real approval workflow for dangerous tools) ===
// Status machine: PENDING_APPROVAL -> APPROVED -> EXECUTING -> COMPLETED
//                                              -> REJECTED
//                                            -> EXPIRED (auto, by background sweep)
//                                            -> FAILED (execution error)
// Token is single-use and hashed (SHA-256). Draft is immutable; an edit creates
// a new ApprovalRequest with parentApprovalId pointing back, and the original is
// marked SUPERSEDED (a terminal state that also invalidates the old token).
model ApprovalRequest {
  id              String   @id @default(cuid())
  // The tool call this approval is for (e.g. "send_email_with_approval").
  toolName        String
  toolUseId       String?  // toolu_... id from the chat stream (if applicable)
  // Immutable draft args (JSON). For email: {to, subject, body}.
  argsJson        String
  // Conversation context for the UI to surface the request inline.
  conversationId  String?
  // Single-use approval token (plaintext issued to UI; the hashed form is stored).
  tokenHash       String   @unique
  // Status enum: PENDING_APPROVAL | APPROVED | REJECTED | EXPIRED | EXECUTING | COMPLETED | FAILED | SUPERSEDED
  status          String   @default("PENDING_APPROVAL")
  // Token expiry (default 15 min from creation). Sweep marks EXPIRED.
  expiresAt       DateTime
  // Edit chain: if the user edits the draft, a new ApprovalRequest is created with
  // parentApprovalId = this one, and this one is set to SUPERSEDED.
  parentApprovalId String?
  // Who/what decided. In this single-user sandbox it's "user"; production would
  // record an authenticated user id + session.
  decidedBy       String?
  decidedAt       DateTime?
  executedAt      DateTime?
  // JSON of the final result (success data or error message).
  resultJson      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([conversationId])
  @@index([status])
  @@index([expiresAt])
}

// === Tool Call Audit Log (observability — every tool call logged) ===
// One row per tool invocation, success or failure. Powers /api/audit and
// gives us: tool name, args, duration, status, retries, truncation, errors,
// approval linkage — everything needed to debug and control cost.
model ToolCallAudit {
  id              String   @id @default(cuid())
  conversationId  String?
  // The chat-stream turn that issued this call (sessionId in code).
  sessionId       String?
  toolName        String
  // Args the model sent (JSON). Truncated to 8 KB to bound row size.
  argsJson        String
  // Result summary: success | failure | denied | invalid | pending
  status          String
  durationMs      Int      @default(0)
  retries         Int      @default(0)
  // Error message (if status != success). Null on success.
  errorMessage    String?
  // Whether the result was truncated before being handed back to the model.
  resultTruncated Boolean  @default(false)
  // Original result size in bytes (before truncation) for cost/debugging.
  resultBytes     Int      @default(0)
  // If this call needed approval, link to the ApprovalRequest.
  approvalId      String?
  // For schema validation failures: the Zod error flatten() output (JSON).
  validationError String?
  // === Workspace isolation audit fields ===
  // The workspace the call targeted (null for non-file tools like web_search).
  workspaceId     String?
  // The relative path the model requested (before resolution).
  requestedPath   String?
  // The absolute path the backend resolved to (after validation). Useful for
  // debugging path-traversal attempts and confirming containment.
  resolvedPath    String?
  // Path-access decision: allowed | denied_absolute | denied_traversal |
  // denied_symlink_escape | denied_outside_workspace | denied_cross_user |
  // n/a (non-file tool). Records WHY a path was accepted or rejected.
  accessDecision  String?
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([toolName])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId])
}

// === Workspaces (per-user / per-project working directories) ===
//
// Each user/project gets an isolated directory tree. All file tools
// (read_file, write_file, list_files, edit_file, run_code_sandbox, create_note)
// operate relative to a workspace root. The model never sees the absolute
// rootPath — only the workspaceId and relative paths.
//
// Default folders created on workspace creation:
//   input/  documents/  code/  notes/  output/  .agent/  .agent/audit/
//
// Storage is local disk in dev (under .workspaces/{userId}/{wsId}/). Production
// should swap the storage adapter for S3/R2 — see src/lib/workspace.ts STORAGE.
model Workspace {
  id          String   @id @default(cuid())
  // Single-user sandbox: always "default". Multi-user: the authenticated user id.
  userId      String   @default("default")
  // Optional: link workspace to a project (existing Project model).
  projectId   String?
  name        String
  // Absolute filesystem path of the workspace root. NEVER exposed to the model.
  rootPath    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files       WorkspaceFile[]

  @@index([userId])
  @@index([projectId])
}

model WorkspaceFile {
  id          String   @id @default(cuid())
  workspaceId String
  // Relative path within the workspace (e.g. "documents/report.md").
  path        String
  // MIME type from magic-byte sniffing (not just extension). Null until scanned.
  sniffedMimeType String?
  // Legacy MIME field (from extension) — kept for backward compat. Prefer sniffedMimeType.
  mimeType    String?
  sizeBytes   Int      @default(0)
  // SHA-256 checksum for dedup / integrity. Null if not computed.
  checksum    String?
  // File lifecycle status (P1-3):
  //   UPLOADED   — just received, not yet validated
  //   SCANNING   — MIME sniff + blocklist check in progress
  //   READY      — validated, safe for agent to read
  //   INDEXED    — READY + added to RAG/knowledge base
  //   QUARANTINED — failed validation (executable, suspicious MIME, oversize)
  //   DELETED    — soft-deleted; not readable
  status      String   @default("UPLOADED")
  // If QUARANTINED, the reason (e.g. "executable_blocklist", "mime_mismatch",
  // "oversize", "scan_error"). Null when READY/INDEXED.
  quarantineReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, path])
  @@index([workspaceId])
  @@index([status])
}

// === Sandbox Jobs (P0-2) ===
// Every run_code_sandbox / run_shell call is enqueued as a job to the sandbox
// worker mini-service. The API server does NOT execute code inline — it
// creates a SandboxJob row (status QUEUED), POSTs to the worker, and polls
// or streams the result.
//
// Status machine: QUEUED → RUNNING → COMPLETED | FAILED | TIMEOUT | CANCELLED
//
// Isolation tier (recorded in isolationTier):
//   process  — code runs in a child process with empty env, cwd=workspace,
//              timeout, maxBuffer. NOT OS-level isolation. Dev fallback when
//              Docker is unavailable. Code CAN still read world-readable host
//              files; the sandbox worker limits what it can do but a
//              determined adversary could escape. Use only for trusted code.
//   docker   — code runs in `docker run --network none --read-only --memory
//              512m --cpus 1 --user nobody -v <workspace>:/workspace:rw --rm`.
//              Strong isolation. Production minimum for untrusted code.
//   gvisor   — gVisor sandbox (runsc). Stronger than docker runc.
//   microvm  — Firecracker/Kata. Strongest.
//
// The worker auto-detects Docker at boot and records the highest tier
// available; this field is set per-job so you can see what actually ran.
model SandboxJob {
  id              String   @id @default(cuid())
  workspaceId     String
  // The chat-stream turn that enqueued this job.
  conversationId  String?
  sessionId       String?
  // Tool name: run_code_sandbox | run_shell
  toolName        String
  // Args the model sent (JSON): code, language, command, etc.
  argsJson        String
  // QUEUED | RUNNING | COMPLETED | FAILED | TIMEOUT | CANCELLED
  status          String   @default("QUEUED")
  // What isolation tier actually ran (see comment above).
  isolationTier   String   @default("process")
  // stdout / stderr captured by the worker (truncated to 1 MB total).
  stdout          String   @default("")
  stderr          String   @default("")
  // Exit code from the process / container. Null while RUNNING or QUEUED.
  exitCode        Int?
  // If FAILED or TIMEOUT, the error message.
  errorMessage    String?
  // Timing: when the worker picked it up, when it finished.
  startedAt       DateTime?
  finishedAt      DateTime?
  // Hard limits applied (recorded so audits can verify):
  //   timeoutMs, maxBufferBytes, maxProcesses, memoryLimitMb, cpuLimit
  limitsJson      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// === Learning product models (informed by pelajarin RE) ===
// ============================================================
// Patterns confirmed by authenticated RE (RECON-AUTHENTICATED.md):
//   - Note: create-then-attach (POST /notes empty → add files later)
//   - Document: presign R2 → PUT → POST /notes with file_ids
//   - Async jobs for ALL LLM generation (note/flashcard/quiz/exam)
//   - Chat: {note_id, session_id (uuid), message} → fetch+ReadableStream
//   - Response envelope {data:...}; pagination page OR cursor based
//   - FSRS for flashcards; gamification via /api/v1/events
//   - Subjects first-class (id, name, icon, icon_color)
//   - exam_type is free-form string (not enum)
// Free tier: 15 notes/month, 50 chats/month, full quiz/flashcard (vs pelajarin 1 note, 0 chat, first-only)

// === Subjects (organize notes/exams) ===
model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?
  iconColor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes StudyNote[]
  exams Exam[]

  @@index([userId])
}

// === Study notes (the central entity) ===
model StudyNote {
  id                 String   @id @default(cuid())
  userId             String
  title              String                    @default("Catatan Baru")
  description        String?
  // AI-generated content: markdown string + structured JSON for rich editor
  content            String?
  contentJson        String?
  status             String   @default("ready")  // ready | processing | completed | error
  studyMode          String   @default("standard")
  tone               String   @default("friendly")
  sourceLanguage     String?
  generationLanguage String?
  // Async job reference (for generation progress via SSE)
  jobId              String?
  // Public sharing (per pelajarin: is_public, is_owner)
  isPublic           Boolean  @default(false)
  // Soft censor flag (we don't censor on free, but keep the field)
  isCensored         Boolean  @default(false)
  // Error handling
  errorMessage       String?
  errorCode          String?
  canRetry           Boolean  @default(false)
  // Subject link
  subjectId          String?
  subject            Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // Denormalized counts (for list views, per pelajarin)
  totalChapters      Int      @default(0)
  flashcardCount     Int      @default(0)
  quizCount          Int      @default(0)
  // File attachments (uploaded source documents)
  fileIdsJson        String   @default("[]")  // JSON array of Document.id
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  chapters   Chapter[]
  flashcards Flashcard[]
  quizzes    Quiz[]
  chatSessions ChatSession[]

  @@index([userId])
  @@index([subjectId])
  @@index([status])
  @@index([updatedAt])
}

// === Chapters (subdivisions of a note, per pelajarin) ===
model Chapter {
  id        String   @id @default(cuid())
  noteId    String
  note      StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  title     String
  content   String?
  // Source references (citations back to uploaded material)
  sourcesJson String? // JSON: [{file_id, page, snippet}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
}

// === Flashcards (FSRS spaced repetition, per RECON-DEEP-v3 E-016) ===
model Flashcard {
  id        String   @id @default(cuid())
  noteId    String
  note      StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  front     String
  back      String
  // FSRS state (computed by the FSRS algorithm after each review)
  fsrsStateJson String? // JSON: {stability, difficulty, retrievability, lastReview, nextReview, reps, lapses}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
}

// === Quizzes ===
model Quiz {
  id        String   @id @default(cuid())
  noteId    String
  note      StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]

  @@index([noteId])
}

// === Questions (MC or short-answer, per pelajarin) ===
model Question {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order        Int      @default(0)
  type         String   @default("mc")     // mc | sa
  question     String
  optionsJson  String?                       // JSON string[] for MC
  answer       String
  explanation  String?
  hint         String?
  difficulty   String   @default("medium")   // easy | medium | hard
  sourcesJson  String?                       // JSON [{file_id, snippet}]
  xp           Int      @default(10)
  // Hint usage tracking (per pelajarin: hint = -50% XP)
  hintUsed     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([quizId])
}

// === Chat sessions (per note, per pelajarin E-AUTH-008) ===
model ChatSession {
  id        String   @id @default(cuid())
  noteId    String
  note      StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([noteId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // user | assistant
  content   String
  // RAG sources cited in the answer (per pelajarin Sumber feature)
  sourcesJson String? // JSON [{file_id, snippet, page}]
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// === Exams (aggregates questions from notes/quizzes) ===
model Exam {
  id              String   @id @default(cuid())
  userId          String
  title           String
  // exam_type is free-form string (not enum, per E-AUTH-010)
  examType        String   @default("quiz")
  status          String   @default("pending") // pending | processing | completed | error
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectIcon     String?
  subjectIconColor String?
  // Aggregates
  paperCount      Int      @default(0)
  insightsCount   Int      @default(0)
  // Error handling
  errorMessage    String?
  errorCode       String?
  failedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  papers ExamPaper[]

  @@index([userId])
  @@index([subjectId])
  @@index([status])
}

model ExamPaper {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  title     String?
  // Source note IDs that contributed questions
  sourceNoteIdsJson String @default("[]")
  // Generated questions (JSON array inline for simplicity)
  questionsJson String @default("[]")
  createdAt DateTime @default(now())

  @@index([examId])
}

// === Gamification: streak + XP + level ===
model UserStreak {
  id              String   @id @default(cuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActivityDate DateTime?
  updatedAt       DateTime @updatedAt
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int                  // positive for gain, negative for loss (hint = -50%)
  reason    String               // quiz_passed | flashcard_reviewed | chat_session | daily_login
  metadataJson String?          // JSON context
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// === Affiliate program ===
model AffiliateCode {
  id              String   @id @default(cuid())
  userId          String   @unique
  code            String   @unique
  discountPercent Int      @default(5)
  tier            String   @default("bronze") // bronze | silver | gold | platinum | diamond
  active          Boolean  @default(true)
  totalConversions Int     @default(0)
  totalEarnings   Int      @default(0) // in IDR cents
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversions AffiliateConversion[]
}

model AffiliateConversion {
  id            String   @id @default(cuid())
  affiliateId   String
  affiliate     AffiliateCode @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String
  plan          String   // free | pro | unlimited
  amount        Int      // in IDR cents
  commissionPercent Int
  commissionAmount Int   // in IDR cents
  status        String   @default("pending") // pending | paid | refunded
  convertedAt   DateTime @default(now())

  @@index([affiliateId])
  @@index([referredUserId])
}

// === Subscriptions (per pelajarin E-AUTH-003) ===
model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  plan            String   @default("free") // free | pro | unlimited | institutional
  status          String   @default("active") // active | trialing | past_due | canceled | expired
  // Usage counters (reset weekly/monthly per plan)
  notesUsed       Int      @default(0)
  chatsUsed       Int      @default(0)
  examsUsed       Int      @default(0)
  podcastSecondsUsed Int   @default(0)
  notesResetDate  DateTime?
  chatResetDate   DateTime?
  examsResetDate  DateTime?
  podcastResetDate DateTime?
  // Stripe + RevenueCat integration (per E-003)
  stripeCustomerId String?
  stripeSubscriptionId String?
  revenuecatId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([plan])
  @@index([status])
}

// === Study documents (uploaded source files, per pelajarin Document model) ===
// Separate from WorkspaceFile — these are user-facing study materials,
// while WorkspaceFile is the agent-internal file system. StudyDocument
// links to the actual storage (R2 key) and the workspace file (for
// text extraction + RAG indexing).
model StudyDocument {
  id           String   @id @default(cuid())
  userId       String
  filename     String
  contentType   String
  sizeBytes    Int
  // Storage key in R2 (per pelajarin E-AUTH-009: owned/<user_id>/uploads/<uuid>.<ext>)
  storageKey   String
  // Linked workspace file (for text extraction + RAG)
  workspaceFileId String?
  // Extraction status
  extractionStatus String @default("pending") // pending | extracting | completed | error
  extractedText String?  // cached extracted text (truncated to fit)
  extractedChunksJson String? // JSON [{chunk_idx, text, tokens, page?}]
  // For audio/video
  durationSeconds Int?
  transcriptText String?
  // For YouTube
  youtubeVideoId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([extractionStatus])
}

// === Async jobs (generalize pelajarin pattern: note-<id>, quiz-<id>, flashcard-<id>) ===
model StudyJob {
  id           String   @id @default(cuid())
  // Job type prefix (note-, quiz-, flashcard-, exam-, chat-, extraction-)
  jobType      String
  userId       String
  // Reference to the entity being processed
  noteId       String?
  quizId       String?
  flashcardId  String?
  examId       String?
  sessionId    String?
  documentId   String?
  // Status machine
  status       String   @default("queued") // queued | running | completed | failed | timeout | cancelled
  progress     Int      @default(0) // 0-100
  // Result + error
  resultJson   String?  // JSON result data
  errorMessage String?
  // Timing
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
}
